// JSON (RFC 8259). `parse` reads a document into a `Value`, `to_string`
// / `to_pretty` write one, and `ToJson` / `FromJson` (with
// `#[derive(Json)]`) map rok types to and from `Value`, as std's
// `rokon` does for ROKON. `Tokenizer` reads large inputs as a stream of
// `Event`s.
//
// Decode errors carry a JSON Pointer `path` (`/servers/1/port`);
// `from_str` turns it into `line:col` by re-reading the document up to
// that path, so the happy path keeps no positions.

pub mod read;
pub mod write;
mod convert;

pub use read::{Event, Tokenizer, MAX_DEPTH};

/// A JSON value. Integers without a fraction or exponent are exact
/// (`Int`); other numbers are `Float`. Objects keep insertion order; a
/// repeated key keeps its first position and its last value.
#[derive(Clone, PartialEq, Debug)]
pub enum Value {
    Null,
    Bool(bool),
    Int(int),
    Float(f64),
    Str(str),
    Array(List<Value>),
    Object(OrderedDict<str, Value>),
}

impl Value {
    /// Compact text. Panics on a NaN / infinite float.
    pub fn to_string(self) -> str {
        let out = StrBuf::new();
        write::value(out, self, 0, 0);
        out.to_str()
    }

    /// Text with each member on its own line, `indent` spaces per level
    /// (`0` is `to_string`).
    pub fn to_pretty(self, indent: usize) -> str {
        let out = StrBuf::new();
        write::value(out, self, indent, 0);
        out.to_str()
    }

    /// What kind of value this is, for messages.
    pub fn kind(self) -> str {
        match self {
            Value::Null => "null",
            Value::Bool(_) => "bool",
            Value::Int(_) => "integer",
            Value::Float(_) => "float",
            Value::Str(_) => "string",
            Value::Array(_) => "array",
            Value::Object(_) => "object",
        }
    }

    /// Member `key` of an object.
    pub fn get(self, key: str) -> Value | none {
        match self {
            Value::Object(m) => m.get(key),
            _ => none,
        }
    }

    /// Item `i` of an array.
    pub fn at(self, i: usize) -> Value | none {
        match self {
            Value::Array(xs) => xs.get(i),
            _ => none,
        }
    }

    /// The value at JSON Pointer `p` (RFC 6901): `""` is the whole value,
    /// `/a/0` member `a` then item 0, `~1` / `~0` stand for `/` / `~`.
    /// `none` when there is no such value or `p` is malformed.
    pub fn pointer(self, p: str) -> Value | none {
        if p.is_empty() { return self; }
        if !p.starts_with("/") { return none; }
        let cur = self;
        for raw in p[1:].split("/") {
            let tok = unescape_token(raw)?;
            cur = match cur {
                Value::Object(m) => m.get(tok)?,
                Value::Array(xs) => {
                    let ok = !tok.is_empty() && tok.chars().all(|c| c.is_ascii_digit())
                        && (tok == "0" || !tok.starts_with("0"));
                    if !ok { return none; }
                    xs.get(try tok.parse::<usize>() catch _ { return none; })?
                },
                _ => return none,
            };
        }
        cur
    }

    pub fn is_null(self) -> bool { self == Value::Null }

    pub fn as_bool(self) -> bool | none {
        match self {
            Value::Bool(b) => b,
            _ => none,
        }
    }

    pub fn as_int(self) -> int | none {
        match self {
            Value::Int(n) => n,
            _ => none,
        }
    }

    /// A number as `f64` (an `Int` rounds to the nearest).
    pub fn as_f64(self) -> f64 | none {
        match self {
            Value::Int(n) => n.to_f64(),
            Value::Float(x) => x,
            _ => none,
        }
    }

    pub fn as_str(self) -> str | none {
        match self {
            Value::Str(s) => s,
            _ => none,
        }
    }

    pub fn as_array(self) -> List<Value> | none {
        match self {
            Value::Array(xs) => xs,
            _ => none,
        }
    }

    pub fn as_object(self) -> OrderedDict<str, Value> | none {
        match self {
            Value::Object(m) => m,
            _ => none,
        }
    }
}

impl Display for Value {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.to_string()) }
}

/// `k` as a JSON Pointer reference token (`~` -> `~0`, `/` -> `~1`).
pub fn escape_token(k: str) -> str {
    if !k.contains("~") && !k.contains("/") { return k; }
    k.replace("~", "~0").replace("/", "~1")
}

/// A reference token's text; `none` for a `~` not followed by `0` / `1`.
fn unescape_token(t: str) -> str | none {
    if !t.contains("~") { return t; }
    let out = StrBuf::new();
    let tilde = false;
    for c in t.chars() {
        if tilde {
            if c == '0' { out.push('~'); } else if c == '1' { out.push('/'); } else { return none; }
            tilde = false;
        } else if c == '~' {
            tilde = true;
        } else {
            out.push(c);
        }
    }
    if tilde { return none; }
    out.to_str()
}

/// A read or decode error. `line` / `col` (1-based, code points) are 0
/// when the value did not come from text; `path` is a JSON Pointer to the
/// failing part (`/servers/2/port`, empty at the root).
pub struct JsonError {
    pub msg: str;
    pub line: u32;
    pub col: u32;
    pub path: str;
    /// The error is about an object key, not its value (`from_str`
    /// points at the key).
    pub(pkg) on_key: bool;
}

impl JsonError {
    pub fn new(msg: str) -> JsonError {
        JsonError { msg: msg, line: 0u32, col: 0u32, path: "", on_key: false }
    }

    /// `self` one level down: `seg` (`/name`, `/3`) goes in front of the path.
    pub fn within(self, seg: str) -> JsonError {
        JsonError { msg: self.msg, line: self.line, col: self.col, path: seg + self.path, on_key: self.on_key }
    }

    pub(pkg) fn at_key(self) -> JsonError {
        JsonError { msg: self.msg, line: self.line, col: self.col, path: self.path, on_key: true }
    }
}

impl Display for JsonError {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        let s = if self.line > 0u32 {
            f"{self.line}:{self.col}: {self.msg}"
        } else if self.path != "" {
            f"at {self.path}: {self.msg}"
        } else {
            self.msg
        };
        try f.write_str(s)
    }
}

impl Debug for JsonError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"JsonError({self})") }
}

impl Error for JsonError {}

/// A rok value as JSON.
pub trait ToJson {
    fn to_json(self) -> Value;
}

/// A rok value from JSON; the target type decides how `v` reads.
pub trait FromJson {
    fn from_json(v: Value) throws (JsonError) -> Self;

    /// An object member of this type that the document leaves out: an
    /// error, except `T | none` (`none`).
    fn from_missing() throws (JsonError) -> Self {
        throw JsonError::new("missing");
    }
}

/// Read one document (nesting up to `MAX_DEPTH`).
pub fn parse(s: str) throws (JsonError) -> Value {
    try read::parse_with(Tokenizer::new(s))
}

/// Read one document from a tokenizer (set its `max_depth` first to
/// change the limit; `Tokenizer::from_reader` reads a stream).
pub fn parse_tokens(t: Tokenizer) throws (JsonError) -> Value {
    try read::parse_with(t)
}

/// `x` as compact JSON. Panics on a NaN / infinite float.
pub fn to_string<T: ToJson>(x: T) -> str { x.to_json().to_string() }

/// `x` as JSON indented by 2 spaces.
pub fn to_pretty<T: ToJson>(x: T) -> str { x.to_json().to_pretty(2) }

/// Read a document as a `T`; errors carry the `line:col` of the part
/// that did not fit.
pub fn from_str<T: FromJson>(s: str) throws (JsonError) -> T {
    let v = try parse(s);
    try T::from_json(v) catch e { throw read::locate(s, e); }
}

/// `x` as a `Value`.
pub fn encode<T: ToJson>(x: T) -> Value { x.to_json() }

/// `v` as a `T`, errors placed under `seg`.
pub fn decode<T: FromJson>(v: Value, seg: str) throws (JsonError) -> T {
    try T::from_json(v) catch e { throw e.within(seg); }
}

pub(pkg) fn mismatch<T>(v: Value) -> JsonError {
    JsonError::new(f"expected {T::type_name()}, found {v.kind()}")
}

/// The pointer segment of member `k`.
pub fn seg(k: str) -> str { "/" + escape_token(k) }

// Used by `#[derive(Json)]`.

/// The members read into a struct or a named variant.
pub struct Fields {
    vals: OrderedDict<str, Value>;
    ctx: str;
}

impl Fields {
    /// `v` as the members of `ctx`; a member not in `names` is an error.
    pub fn of(v: Value, ctx: str, names: List<str>) throws (JsonError) -> Fields {
        let m = match v {
            Value::Object(m) => m,
            _ => throw JsonError::new(f"expected {ctx} (an object), found {v.kind()}"),
        };
        for (k, _) in m.entries() {
            if !names.iter().any(|n| n == k) {
                throw JsonError::new(f"unknown field `{k}` in {ctx}").within(seg(k)).at_key();
            }
        }
        Fields { vals: m, ctx: ctx }
    }

    pub fn has(self, name: str) -> bool { self.vals.contains_key(name) }

    /// Member `name` as a `T`: its value, or `T::from_missing()` when absent.
    pub fn get<T: FromJson>(self, name: str) throws (JsonError) -> T {
        if let v: Value = self.vals.get(name) { return try decode::<T>(v, seg(name)); }
        try T::from_missing() catch _ { throw JsonError::new(f"missing field `{name}` in {self.ctx}"); }
    }
}

/// Tuple values as JSON: one value as itself, more as an array.
pub fn pack(xs: List<Value>) -> Value {
    if xs.len() == 1 { xs[0] } else { Value::Array(xs) }
}

/// `pack` reversed: `n` values of `ctx`.
pub fn unpack(v: Value, ctx: str, n: usize) throws (JsonError) -> List<Value> {
    if n == 1 { return [v]; }
    let xs = match v {
        Value::Array(xs) => xs,
        _ => throw JsonError::new(f"expected {ctx} (an array of {n}), found {v.kind()}"),
    };
    if xs.len() != n { throw JsonError::new(f"{ctx} takes {n} values, found {xs.len()}"); }
    xs
}

/// `v` as a variant of enum `ctx`: `"V"` for a unit variant, else
/// `{ "V": payload }`. (variant name, payload or `none`).
pub fn variant_of(v: Value, ctx: str) throws (JsonError) -> (str, Value | none) {
    match v {
        Value::Str(s) => (s, none),
        Value::Object(m) => {
            if m.len() != 1 { throw JsonError::new(f"expected a {ctx} variant (an object with one key), found {m.len()} keys"); }
            let (k, x) = m.entries().next() ?? ("", Value::Null);
            (k, x)
        },
        _ => throw JsonError::new(f"expected a {ctx} variant, found {v.kind()}"),
    }
}

/// The payload of variant `name`; an error for a bare `"V"`.
pub fn payload(p: Value | none, ctx: str, name: str) throws (JsonError) -> Value {
    match p {
        x: Value => x,
        none => throw JsonError::new(f"variant `{ctx}::{name}` needs a value"),
    }
}

/// A unit variant written `{ "V": .. }` is an error unless the payload is null.
pub fn no_payload(p: Value | none, ctx: str, name: str) throws (JsonError) {
    if let x: Value = p {
        if x != Value::Null { throw JsonError::new(f"variant `{ctx}::{name}` takes no value").within(seg(name)); }
    }
}

pub fn unknown_variant(v: str, ctx: str) -> JsonError {
    JsonError::new(f"`{v}` is not a variant of {ctx}")
}

/// `#[derive(Json)]`: `ToJson` + `FromJson` for a struct or an enum.
/// Named struct -> object; tuple struct -> array (one field: the field
/// itself); unit struct -> `null`. Enum variants are externally tagged:
/// unit `"V"`, tuple `{ "V": x }` / `{ "V": [a, b] }`, named
/// `{ "V": { .. } }`. A missing member takes its default (`f: T = expr`),
/// else `none` for `T | none`, else is an error.
#[impl_derive(Json)]
pub @derive {
    @where_all(pkg::ToJson)
    impl pkg::ToJson for @Self {
        fn to_json(self) -> pkg::Value {
            @if_struct {
                @apply_if(@Self.is_tuple) {
                    return pkg::pack([@for_fields { pkg::encode::<@field.type>(self.@field), }]);
                }
                @apply_if(@Self.is_unit) {
                    return pkg::Value::Null;
                }
                @apply_if(@Self.is_named) {
                    let m: OrderedDict<str, pkg::Value> = OrderedDict::new();
                    @for_fields {
                        m.insert(@field.name.as_str(), pkg::encode::<@field.type>(self.@field));
                    }
                    return pkg::Value::Object(m);
                }
            }
            @if_enum {
                return match self {
                    @for_variants {
                        @variant.pattern => {
                            @apply_if(@variant.is_unit) {
                                pkg::Value::Str(@variant.name.as_str())
                            }
                            @apply_if(@variant.is_tuple) {
                                let m: OrderedDict<str, pkg::Value> = OrderedDict::new();
                                m.insert(@variant.name.as_str(), pkg::pack([@for_variant_fields { pkg::encode::<@field.type>(@field), }]));
                                pkg::Value::Object(m)
                            }
                            @apply_if(@variant.is_named) {
                                let fs: OrderedDict<str, pkg::Value> = OrderedDict::new();
                                @for_variant_fields {
                                    fs.insert(@field.name.as_str(), pkg::encode::<@field.type>(@field));
                                }
                                let m: OrderedDict<str, pkg::Value> = OrderedDict::new();
                                m.insert(@variant.name.as_str(), pkg::Value::Object(fs));
                                pkg::Value::Object(m)
                            }
                        },
                    }
                };
            }
        }
    }

    @where_all(pkg::FromJson)
    impl pkg::FromJson for @Self {
        fn from_json(v: pkg::Value) throws (pkg::JsonError) -> Self {
            @if_struct {
                @apply_if(@Self.is_tuple) {
                    let xs = try pkg::unpack(v, @Self.as_str(), [@for_fields { 0, }].len());
                    return @Self(@for_fields {
                        try pkg::decode::<@field.type>(xs[@field.name], if xs.len() == 1 { "" } else { "/" + @field.name.as_str() }),
                    });
                }
                @apply_if(@Self.is_unit) {
                    if v != pkg::Value::Null { throw pkg::JsonError::new(f"expected {@Self.as_str()} (null), found {v.kind()}"); }
                    return @Self;
                }
                @apply_if(@Self.is_named) {
                    let fs = try pkg::Fields::of(v, @Self.as_str(), [@for_fields { @field.name.as_str(), }]);
                    return @Self {
                        @for_fields {
                            @apply_if(@field.has_default) {
                                @field: if fs.has(@field.name.as_str()) {
                                    try fs.get::<@field.type>(@field.name.as_str())
                                } else {
                                    @field.default
                                },
                            }
                            @apply_if(!@field.has_default) {
                                @field: try fs.get::<@field.type>(@field.name.as_str()),
                            }
                        }
                    };
                }
            }
            @if_enum {
                let (name, p) = try pkg::variant_of(v, @Self.as_str());
                @for_variants {
                    if name == @variant.name.as_str() {
                        @apply_if(@variant.is_unit) {
                            try pkg::no_payload(p, @Self.as_str(), name);
                            return @Self.name::@variant.name;
                        }
                        @apply_if(@variant.is_tuple) {
                            let n = [@for_variant_fields { 0, }].len();
                            let ctx = @Self.as_str() + "::" + name;
                            let xs = try pkg::unpack(try pkg::payload(p, @Self.as_str(), name), ctx, n) catch e { throw e.within(pkg::seg(name)); };
                            return @Self.name::@variant.name(@for_variant_fields {
                                try pkg::decode::<@field.type>(xs[@field.name], pkg::seg(name) + if n == 1 { "" } else { "/" + @field.name.as_str() }),
                            });
                        }
                        @apply_if(@variant.is_named) {
                            let ctx = @Self.as_str() + "::" + name;
                            let fs = try pkg::Fields::of(try pkg::payload(p, @Self.as_str(), name), ctx,
                                [@for_variant_fields { @field.name.as_str(), }]) catch e { throw e.within(pkg::seg(name)); };
                            return @Self.name::@variant.name {
                                @for_variant_fields {
                                    @apply_if(@field.has_default) {
                                        @field.name: if fs.has(@field.name.as_str()) {
                                            try fs.get::<@field.type>(@field.name.as_str()) catch e { throw e.within(pkg::seg(name)); }
                                        } else {
                                            @field.default
                                        },
                                    }
                                    @apply_if(!@field.has_default) {
                                        @field.name: try fs.get::<@field.type>(@field.name.as_str()) catch e { throw e.within(pkg::seg(name)); },
                                    }
                                }
                            };
                        }
                    }
                }
                throw pkg::unknown_variant(name, @Self.as_str());
            }
        }
    }
}
